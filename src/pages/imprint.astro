
---
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/600.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Imprint | Trustpoint</title>
    <meta
      name="description"
      content="Legal information for the Trustpoint project website."
    />
    <meta name="robots" content="noindex, follow" />
    <link
      rel="icon"
      type="image/png"
      href="/logos/trustpoint_favicon.png"
    />
    <link
      rel="canonical"
      href="https://industrial-security.io/imprint"
    />
  </head>

  <body>
    <header>
      <div class="container navigation">
        <a href="/" aria-label="Trustpoint homepage">
          <img
            src="/logos/trustpoint_logo.svg"
            alt="Trustpoint"
            width="180"
          />
        </a>

        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="https://github.com/Trustpoint-Project/trustpoint">
            GitHub
          </a>
        </nav>
